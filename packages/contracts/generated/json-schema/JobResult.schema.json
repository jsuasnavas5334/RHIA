{
  "$id": "https://schemas.rhia.invalid/v1/JobResult.schema.json",
  "title": "RHIA JobResult v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0"
    },
    "jobId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "jobType": {
      "type": "string",
      "enum": [
        "RESOLVE_ENTITY",
        "RESEARCH_COMPANY",
        "DISCOVER_HR",
        "VERIFY_PERSON",
        "FIND_CONTACTABILITY"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "SUCCEEDED",
        "PARTIAL",
        "FAILED"
      ]
    },
    "completedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "output": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "RESOLVE_ENTITY"
            },
            "resolution": {
              "type": "string",
              "enum": [
                "RESOLVED",
                "AMBIGUOUS",
                "INSUFFICIENT_EVIDENCE"
              ]
            },
            "selectedMarket": {
              "type": "object",
              "properties": {
                "countryCode": {
                  "type": "string",
                  "pattern": "^[A-Z]{2}$"
                },
                "regionCode": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 20
                },
                "city": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                }
              },
              "required": [
                "countryCode"
              ],
              "additionalProperties": false
            },
            "candidateCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "evidenceId": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "classification": {
                    "type": "string",
                    "enum": [
                      "EVIDENCE",
                      "FACT",
                      "INFERENCE",
                      "DECISION"
                    ]
                  }
                },
                "required": [
                  "evidenceId",
                  "classification"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "kind",
            "resolution",
            "candidateCount",
            "evidence"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "RESEARCH_COMPANY"
            },
            "companyRef": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "evidenceId": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "classification": {
                    "type": "string",
                    "enum": [
                      "EVIDENCE",
                      "FACT",
                      "INFERENCE",
                      "DECISION"
                    ]
                  }
                },
                "required": [
                  "evidenceId",
                  "classification"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "kind",
            "companyRef",
            "evidence"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "DISCOVER_HR"
            },
            "candidateRefs": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              }
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "evidenceId": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "classification": {
                    "type": "string",
                    "enum": [
                      "EVIDENCE",
                      "FACT",
                      "INFERENCE",
                      "DECISION"
                    ]
                  }
                },
                "required": [
                  "evidenceId",
                  "classification"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "kind",
            "candidateRefs",
            "evidence"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "VERIFY_PERSON"
            },
            "personRef": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "verificationStatus": {
              "type": "string",
              "enum": [
                "VERIFIED",
                "CONFLICTING",
                "UNVERIFIED"
              ]
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "evidenceId": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "classification": {
                    "type": "string",
                    "enum": [
                      "EVIDENCE",
                      "FACT",
                      "INFERENCE",
                      "DECISION"
                    ]
                  }
                },
                "required": [
                  "evidenceId",
                  "classification"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "kind",
            "personRef",
            "verificationStatus",
            "evidence"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "FIND_CONTACTABILITY"
            },
            "contactRefs": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              }
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "evidenceId": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "classification": {
                    "type": "string",
                    "enum": [
                      "EVIDENCE",
                      "FACT",
                      "INFERENCE",
                      "DECISION"
                    ]
                  }
                },
                "required": [
                  "evidenceId",
                  "classification"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "kind",
            "contactRefs",
            "evidence"
          ],
          "additionalProperties": false
        }
      ]
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "RHIA_STATE_INVALID_TRANSITION",
            "RHIA_CONTRACT_INVALID_PAYLOAD",
            "RHIA_SEARCH_PROVIDER_DEGRADED",
            "RHIA_SEARCH_PROVIDER_UNAVAILABLE",
            "RHIA_SEARCH_RATE_LIMITED",
            "RHIA_SEARCH_CAPTCHA_BLOCKED",
            "RHIA_SEARCH_TIMEOUT",
            "RHIA_WORKFLOW_TIMEOUT",
            "RHIA_ENTITY_AMBIGUOUS",
            "RHIA_APPROVAL_REQUIRED",
            "RHIA_POLICY_DENIED",
            "RHIA_JOB_RETRY_EXHAUSTED",
            "RHIA_OUTREACH_OPTED_OUT",
            "RHIA_OUTREACH_PERMANENT_BOUNCE",
            "RHIA_MODEL_RATE_LIMITED",
            "RHIA_MODEL_PROVIDER_UNAVAILABLE",
            "RHIA_TOOL_FORBIDDEN",
            "RHIA_CORE_UNEXPECTED_FAILURE"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "retryable": {
          "type": "boolean"
        },
        "correlationId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "category": {
          "type": "string",
          "enum": [
            "VALIDATION",
            "DEPENDENCY",
            "RATE_LIMIT",
            "TIMEOUT",
            "CONFLICT",
            "POLICY",
            "INTERNAL"
          ]
        },
        "safeDetails": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "required": [
        "code",
        "message",
        "retryable",
        "correlationId",
        "category"
      ],
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "properties": {
        "durationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      },
      "required": [
        "durationMs",
        "attempt"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "jobId",
    "correlationId",
    "jobType",
    "status",
    "completedAt",
    "metrics"
  ],
  "additionalProperties": false
}
