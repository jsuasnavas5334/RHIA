{
  "$id": "https://schemas.rhia.invalid/v1/RhiaSettings.schema.json",
  "title": "RHIA Settings v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0"
    },
    "markets": {
      "type": "object",
      "properties": {
        "restOfLatinAmericaEnabled": {
          "type": "boolean",
          "const": true
        },
        "defaultRegionalPriorityScore": {
          "type": "integer",
          "minimum": 1,
          "maximum": 89
        },
        "priorities": {
          "minItems": 2,
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "countryCode": {
                "type": "string",
                "pattern": "^[A-Z]{2}$"
              },
              "priorityScore": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              }
            },
            "required": [
              "countryCode",
              "priorityScore"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "restOfLatinAmericaEnabled",
        "defaultRegionalPriorityScore",
        "priorities"
      ],
      "additionalProperties": false
    },
    "cadence": {
      "type": "object",
      "properties": {
        "maxProactiveTouches": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "responseFollowupHours": {
          "type": "integer",
          "minimum": 12,
          "maximum": 720
        },
        "channels": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "channel": {
                "type": "string",
                "enum": [
                  "EMAIL",
                  "LINKEDIN",
                  "WHATSAPP"
                ]
              },
              "enabled": {
                "type": "boolean"
              },
              "minimumHoursBetweenTouches": {
                "type": "integer",
                "minimum": 12,
                "maximum": 720
              }
            },
            "required": [
              "channel",
              "enabled",
              "minimumHoursBetweenTouches"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "maxProactiveTouches",
        "responseFollowupHours",
        "channels"
      ],
      "additionalProperties": false
    },
    "scoring": {
      "type": "object",
      "properties": {
        "weights": {
          "type": "object",
          "properties": {
            "marketFit": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "evidenceStrength": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "contactability": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "commercialTiming": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          },
          "required": [
            "marketFit",
            "evidenceStrength",
            "contactability",
            "commercialTiming"
          ],
          "additionalProperties": false
        },
        "minimumOpportunityScore": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": [
        "weights",
        "minimumOpportunityScore"
      ],
      "additionalProperties": false
    },
    "budgets": {
      "type": "object",
      "properties": {
        "searchRequestsPerJob": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "llmTokensPerJob": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000000
        },
        "browserActionsPerJob": {
          "type": "integer",
          "minimum": 0,
          "maximum": 500
        },
        "externalSpendUsdDailyCap": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000
        }
      },
      "required": [
        "searchRequestsPerJob",
        "llmTokensPerJob",
        "browserActionsPerJob",
        "externalSpendUsdDailyCap"
      ],
      "additionalProperties": false
    },
    "providers": {
      "type": "object",
      "properties": {
        "models": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "providerId": {
                "type": "string",
                "enum": [
                  "OPENAI",
                  "ANTHROPIC",
                  "DEEPSEEK",
                  "QWEN",
                  "OLLAMA"
                ]
              },
              "enabled": {
                "type": "boolean"
              },
              "mode": {
                "type": "string",
                "enum": [
                  "LOCAL",
                  "REMOTE"
                ]
              },
              "modelAlias": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "credentialRef": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "priority": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              }
            },
            "required": [
              "providerId",
              "enabled",
              "mode",
              "modelAlias",
              "priority"
            ],
            "additionalProperties": false
          }
        },
        "searchOrder": {
          "minItems": 4,
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "API",
              "PLAYWRIGHT",
              "COMPUTER_USE",
              "HUMAN"
            ]
          }
        },
        "searxngEnabled": {
          "type": "boolean"
        },
        "browserFallbackEnabled": {
          "type": "boolean"
        },
        "computerUseFallbackEnabled": {
          "type": "boolean"
        }
      },
      "required": [
        "models",
        "searchOrder",
        "searxngEnabled",
        "browserFallbackEnabled",
        "computerUseFallbackEnabled"
      ],
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "properties": {
        "workerConcurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "schedulerTimezone": {
          "type": "string",
          "pattern": "^[A-Za-z_]+\\/[A-Za-z_]+$"
        },
        "logLevel": {
          "type": "string",
          "enum": [
            "ERROR",
            "WARN",
            "INFO",
            "DEBUG"
          ]
        }
      },
      "required": [
        "workerConcurrency",
        "schedulerTimezone",
        "logLevel"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "markets",
    "cadence",
    "scoring",
    "budgets",
    "providers",
    "runtime"
  ],
  "additionalProperties": false
}
