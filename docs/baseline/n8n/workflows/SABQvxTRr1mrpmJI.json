        "query": "INSERT INTO public.execution_registry (\n  dedup_key,\n  task_type,\n  entity_type,\n  entity_id,\n  status,\n  payload,\n  completed_at\n)\nVALUES (\n  'heartbeat:' || $1,\n  'system_heartbeat',\n  'system',\n  'rhia_ai',\n  'completed',\n  jsonb_build_object(\n    'sistema', $2::text,\n    'estado', $3::text,\n    'fecha', $1::timestamptz\n  ),\n  $1::timestamptz\n)\nON CONFLICT (dedup_key) DO NOTHING\nRETURNING\n  id,\n  dedup_key,\n  task_type,\n  status,\n  created_at;",
