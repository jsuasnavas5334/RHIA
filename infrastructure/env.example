# RHIA Infrastructure - Environment Configuration
# Copy this file to .env and fill in actual values (never commit .env)
# These variables are used by docker-compose.yml to configure services

# PostgreSQL Main Database
POSTGRES_DB=rhia_core
POSTGRES_USER=rhia
POSTGRES_PASSWORD=your-secure-password-here

# n8n Database (within PostgreSQL)
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=n8n-secure-password-here

# n8n Application
N8N_ENCRYPTION_KEY=your-n8n-encryption-key-here

# SearXNG
SEARXNG_SECRET=your-searxng-secret-here
