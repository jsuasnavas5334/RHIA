{
  "name": "rhia",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11.17.0 <12"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "spikes/*"
  ],
  "scripts": {
    "prebuild": "npm run build:prerequisites",
    "build": "npm run build --workspaces --if-present",
    "build:prerequisites": "npm run build --workspace=@rhia/domain --workspace=@rhia/config --workspace=@rhia/contracts --workspace=@rhia/policy",
    "pretypecheck": "npm run build:prerequisites",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "pretest": "npm run build:prerequisites",
    "test": "npm run test --workspaces --if-present",
    "orm:drizzle": "npm run migration:generate --workspace=@rhia/spike-drizzle"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "typescript": "7.0.2",
    "zod": "4.4.3"
  }
}
